{{- $.Scratch.Add "index" slice -}}
{{- range where .Site.RegularPages "Type" "in" (slice "podcast" "blog") -}}
    {{- $image := "" -}}
    {{- if eq .Type "podcast" -}}
        {{- $image = partial "thumb.html" (printf "%s%s" .Site.Params.podcast.cdn_base_url .Params.image) -}}
    {{- else if .Params.featureImage -}}
        {{- $image = partial "thumb.html" .Params.featureImage -}}
    {{- end -}}
    {{- $.Scratch.Add "index" (dict "title" .Title "summary" .Summary "permalink" .Permalink "section" .Section "date" (.Date | time.Format site.Params.dateFormat) "image" $image) -}}
{{- end -}}
{{- $.Scratch.Get "index" | jsonify -}}
